# Docker Compose only. Host Node/Vite use Backend/.env and frontend/.env instead.
# Generate a local .env automatically: node scripts/docker-setup.js
DB_NAME=vehicle_rental
DB_USER=vehicle_app
DB_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
DB_PUBLISHED_PORT=3307
# Local HTTP only. Use production with an HTTPS deployment.
NODE_ENV=development
